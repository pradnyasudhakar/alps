generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Package {
  id        String    @id @default(cuid())
  title     String
  route     String
  duration  String
  tourType  String
  category  String    @default("Uncategorized")
  price     Int
  image     String
  icons     String[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  bookings  Booking[]
}

model Booking {
  id        String   @id @default(cuid())
  name      String
  email     String
  mobile    String
  message   String?
  package   Package? @relation(fields: [packageId], references: [id])
  packageId String?
  status    String   @default("pending")
  createdAt DateTime @default(now())
}
model Listing {
  id            String   @id @default(cuid())
  title         String
  location      String
  pricePerNight Int
  category      String
  description   String
  images        String[]
  rating        Int      @default(5)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model User {
  id        String   @id @default(cuid())
  name      String?
  email     String   @unique
  password  String?
  role      String   @default("user")
  createdAt DateTime @default(now())
}